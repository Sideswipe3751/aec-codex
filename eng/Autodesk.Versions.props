<Project>
  <!-- This is the single source of truth for Autodesk adapter builds. -->
  <Choose>
    <When Condition="'$(RevitVersion)' == '2024'">
      <PropertyGroup>
        <ReleaseYear>2024</ReleaseYear>
        <RevitAssemblyName>BimBridge.Revit2024</RevitAssemblyName>
        <RevitManifestName>BimBridge.Revit2024.addin</RevitManifestName>
        <RevitTargetFramework>net48</RevitTargetFramework>
        <RevitRuntimeFamily>netfx</RevitRuntimeFamily>
        <RevitRuntimeResolution>fixed</RevitRuntimeResolution>
        <RevitSupportedTargetFrameworks>net48</RevitSupportedTargetFrameworks>
        <RevitDynamicCompiler>codedom</RevitDynamicCompiler>
        <RevitUseRevitContext>false</RevitUseRevitContext>
        <RevitProviderAvailable>true</RevitProviderAvailable>
        <RevitSupportStatus>implemented</RevitSupportStatus>
        <RevitCertificationStatus>certified</RevitCertificationStatus>
        <RevitInstallSubdirectory>Autodesk\Revit 2024</RevitInstallSubdirectory>
        <RevitDefaultTemplateSubdirectory>Autodesk\RVT 2024\Templates\Default_M_ENU.rte</RevitDefaultTemplateSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(RevitVersion)' == '2025'">
      <PropertyGroup>
        <ReleaseYear>2025</ReleaseYear>
        <RevitAssemblyName>BimBridge.Revit2025</RevitAssemblyName>
        <RevitManifestName>BimBridge.Revit2025.addin</RevitManifestName>
        <RevitTargetFramework>net8.0-windows</RevitTargetFramework>
        <RevitRuntimeFamily>modern</RevitRuntimeFamily>
        <RevitRuntimeResolution>installed-api-runtime</RevitRuntimeResolution>
        <RevitSupportedTargetFrameworks>net8.0-windows;net10.0-windows</RevitSupportedTargetFrameworks>
        <RevitDynamicCompiler>roslyn</RevitDynamicCompiler>
        <RevitUseRevitContext>true</RevitUseRevitContext>
        <RevitProviderAvailable>false</RevitProviderAvailable>
        <RevitSupportStatus>implemented</RevitSupportStatus>
        <RevitCertificationStatus>certified</RevitCertificationStatus>
        <RevitInstallSubdirectory>Autodesk\Revit 2025</RevitInstallSubdirectory>
        <RevitDefaultTemplateSubdirectory>Autodesk\RVT 2025\Templates\Default_M_ENU.rte</RevitDefaultTemplateSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(RevitVersion)' == '2026'">
      <PropertyGroup>
        <ReleaseYear>2026</ReleaseYear>
        <RevitAssemblyName>BimBridge.Revit2026</RevitAssemblyName>
        <RevitManifestName>BimBridge.Revit2026.addin</RevitManifestName>
        <RevitTargetFramework>net8.0-windows</RevitTargetFramework>
        <RevitRuntimeFamily>modern</RevitRuntimeFamily>
        <RevitRuntimeResolution>installed-api-runtime</RevitRuntimeResolution>
        <RevitSupportedTargetFrameworks>net8.0-windows;net10.0-windows</RevitSupportedTargetFrameworks>
        <RevitDynamicCompiler>roslyn</RevitDynamicCompiler>
        <RevitUseRevitContext>false</RevitUseRevitContext>
        <RevitProviderAvailable>false</RevitProviderAvailable>
        <RevitSupportStatus>implemented</RevitSupportStatus>
        <RevitCertificationStatus>certified</RevitCertificationStatus>
        <RevitInstallSubdirectory>Autodesk\Revit 2026</RevitInstallSubdirectory>
        <RevitDefaultTemplateSubdirectory>Autodesk\RVT 2026\Templates\Default_M_ENU.rte</RevitDefaultTemplateSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(RevitVersion)' == '2027'">
      <PropertyGroup>
        <ReleaseYear>2027</ReleaseYear>
        <RevitAssemblyName>BimBridge.Revit2027</RevitAssemblyName>
        <RevitManifestName>BimBridge.Revit2027.addin</RevitManifestName>
        <RevitTargetFramework>net10.0-windows</RevitTargetFramework>
        <RevitRuntimeFamily>modern</RevitRuntimeFamily>
        <RevitRuntimeResolution>fixed</RevitRuntimeResolution>
        <RevitSupportedTargetFrameworks>net10.0-windows</RevitSupportedTargetFrameworks>
        <RevitDynamicCompiler>roslyn</RevitDynamicCompiler>
        <RevitUseRevitContext>false</RevitUseRevitContext>
        <RevitProviderAvailable>false</RevitProviderAvailable>
        <RevitSupportStatus>implemented</RevitSupportStatus>
        <RevitCertificationStatus>certified</RevitCertificationStatus>
        <RevitInstallSubdirectory>Autodesk\Revit 2027</RevitInstallSubdirectory>
        <RevitDefaultTemplateSubdirectory>Autodesk\RVT 2027\Templates\Default_M_ENU.rte</RevitDefaultTemplateSubdirectory>
      </PropertyGroup>
    </When>
  </Choose>
  <Choose>
    <When Condition="'$(AutoCADVersion)' == '2024'">
      <PropertyGroup>
        <AutoCADReleaseYear>2024</AutoCADReleaseYear>
        <AutoCADAssemblyName>BimBridge.AutoCAD2024</AutoCADAssemblyName>
        <AutoCADTargetFramework>net48</AutoCADTargetFramework>
        <AutoCADSupportedTargetFrameworks>net48</AutoCADSupportedTargetFrameworks>
        <AutoCADRuntimeFamily>netfx</AutoCADRuntimeFamily>
        <AutoCADRuntimeResolution>fixed</AutoCADRuntimeResolution>
        <AutoCADDynamicCompiler>codedom</AutoCADDynamicCompiler>
        <AutoCADSeries>R24.3</AutoCADSeries>
        <AutoCADSupportStatus>implemented</AutoCADSupportStatus>
        <AutoCADCertificationStatus>certified</AutoCADCertificationStatus>
        <AutoCADInstallSubdirectory>Autodesk\AutoCAD 2024</AutoCADInstallSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(AutoCADVersion)' == '2025'">
      <PropertyGroup>
        <AutoCADReleaseYear>2025</AutoCADReleaseYear>
        <AutoCADAssemblyName>BimBridge.AutoCAD2025</AutoCADAssemblyName>
        <AutoCADTargetFramework>net8.0-windows</AutoCADTargetFramework>
        <AutoCADSupportedTargetFrameworks>net8.0-windows;net10.0-windows</AutoCADSupportedTargetFrameworks>
        <AutoCADRuntimeFamily>modern</AutoCADRuntimeFamily>
        <AutoCADRuntimeResolution>installed-api-runtime</AutoCADRuntimeResolution>
        <AutoCADDynamicCompiler>roslyn</AutoCADDynamicCompiler>
        <AutoCADSeries>R25.0</AutoCADSeries>
        <AutoCADSupportStatus>implemented</AutoCADSupportStatus>
        <AutoCADCertificationStatus>certified</AutoCADCertificationStatus>
        <AutoCADInstallSubdirectory>Autodesk\AutoCAD 2025</AutoCADInstallSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(AutoCADVersion)' == '2026'">
      <PropertyGroup>
        <AutoCADReleaseYear>2026</AutoCADReleaseYear>
        <AutoCADAssemblyName>BimBridge.AutoCAD2026</AutoCADAssemblyName>
        <AutoCADTargetFramework>net8.0-windows</AutoCADTargetFramework>
        <AutoCADSupportedTargetFrameworks>net8.0-windows;net10.0-windows</AutoCADSupportedTargetFrameworks>
        <AutoCADRuntimeFamily>modern</AutoCADRuntimeFamily>
        <AutoCADRuntimeResolution>installed-api-runtime</AutoCADRuntimeResolution>
        <AutoCADDynamicCompiler>roslyn</AutoCADDynamicCompiler>
        <AutoCADSeries>R25.1</AutoCADSeries>
        <AutoCADSupportStatus>implemented</AutoCADSupportStatus>
        <AutoCADCertificationStatus>certified</AutoCADCertificationStatus>
        <AutoCADInstallSubdirectory>Autodesk\AutoCAD 2026</AutoCADInstallSubdirectory>
      </PropertyGroup>
    </When>
    <When Condition="'$(AutoCADVersion)' == '2027'">
      <PropertyGroup>
        <AutoCADReleaseYear>2027</AutoCADReleaseYear>
        <AutoCADAssemblyName>BimBridge.AutoCAD2027</AutoCADAssemblyName>
        <AutoCADTargetFramework>net10.0-windows</AutoCADTargetFramework>
        <AutoCADSupportedTargetFrameworks>net10.0-windows</AutoCADSupportedTargetFrameworks>
        <AutoCADRuntimeFamily>modern</AutoCADRuntimeFamily>
        <AutoCADRuntimeResolution>fixed</AutoCADRuntimeResolution>
        <AutoCADDynamicCompiler>roslyn</AutoCADDynamicCompiler>
        <AutoCADSeries>R26.0</AutoCADSeries>
        <AutoCADSupportStatus>implemented</AutoCADSupportStatus>
        <AutoCADCertificationStatus>certified</AutoCADCertificationStatus>
        <AutoCADInstallSubdirectory>Autodesk\AutoCAD 2027</AutoCADInstallSubdirectory>
      </PropertyGroup>
    </When>
  </Choose>
</Project>
