<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Aec.Codex.Revit</RootNamespace>
    <AssemblyName>Aec.Codex.Revit2024</AssemblyName>
    <Revit2024InstallDir Condition="'$(Revit2024InstallDir)' == ''">C:\Program Files\Autodesk\Revit 2024</Revit2024InstallDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aec.Codex.Bridge/Aec.Codex.Bridge.csproj" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="RevitAPI">
      <HintPath>$(Revit2024InstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(Revit2024InstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="CheckRevit2024References" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Revit2024InstallDir)\RevitAPI.dll')" Text="Revit 2024 API was not found at $(Revit2024InstallDir). Set Revit2024InstallDir." />
  </Target>
</Project>
