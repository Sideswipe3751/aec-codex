<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AutoCADVersion>2024</AutoCADVersion>
    <AutoCADInstallDir Condition="'$(AutoCADInstallDir)' == '' and '$(AutoCAD2024InstallDir)' != ''">$(AutoCAD2024InstallDir)</AutoCADInstallDir>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <!-- Compatibility shim for legacy build and packaging inputs. It imports the
       shared product implementation and must not contain AutoCAD business code. -->
  <Import Project="../BimBridge.AutoCAD/BimBridge.AutoCAD.Adapter.props" />
</Project>
