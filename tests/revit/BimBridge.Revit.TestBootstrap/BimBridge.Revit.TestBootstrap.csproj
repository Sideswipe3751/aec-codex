<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../eng/Autodesk.Versions.props" />
  <PropertyGroup>
    <TargetFramework Condition="'$(RevitTargetFramework)' != ''">$(RevitTargetFramework)</TargetFramework>
    <TargetFramework Condition="'$(RevitTargetFramework)' == ''">netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <RootNamespace>BimBridge.Revit.LiveTest</RootNamespace>
    <AssemblyName>BimBridge.Revit.TestBootstrap$(RevitVersion)</AssemblyName>
    <RevitInstallDir Condition="'$(RevitInstallDir)' == ''">C:\Program Files\Autodesk\Revit $(RevitVersion)</RevitInstallDir>
    <OutputPath Condition="'$(OutputPath)' == ''">bin\$(Configuration)\$(RevitVersion)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RevitVersion" Value="$(RevitVersion)" />
    <Reference Include="RevitAPI">
      <HintPath>$(RevitInstallDir)\RevitAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(RevitInstallDir)\RevitAPIUI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
    <Compile Include="*.cs" />
  </ItemGroup>
  <Target Name="ValidateRevitLiveTestConfiguration" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RevitVersion)' == ''" Text="RevitVersion is required. Use eng/Run-RevitLiveAcceptance.ps1." />
    <Error Condition="'$(ReleaseYear)' == ''" Text="RevitVersion '$(RevitVersion)' is not declared in eng/Autodesk.Versions.props." />
    <Error Condition="!Exists('$(RevitInstallDir)\RevitAPI.dll')" Text="Revit $(RevitVersion) API was not found at $(RevitInstallDir)." />
  </Target>
</Project>
